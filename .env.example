# Local mode needs no cloud services. Copy to .env at the repository root.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
API_URL=http://127.0.0.1:4000
# Set a long, random secret before sharing beyond your machine (32+ characters).
SESSION_SECRET=local-development-only-change-before-deploying
# Omit DATABASE_URL for persistent embedded PostgreSQL in .data/brain-battle.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brain_battle
# Optional local-only directory; relative paths resolve from the repository root.
# PGLITE_DIRECTORY=.data/brain-battle
# Enable anonymous sign-ins in Supabase before setting BOTH values.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Development fallback is prohibited in production.
